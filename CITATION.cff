    given-names: "Ravil"
    affiliation: "Digital Economy Lab"
    orcid: "https://orcid.org/0000-0002-0783-8573"
keywords:
  - housing market
  - price gap
  - mortgage subsidies
  - macroprudential policy
  - regional indicators
  - Russia
